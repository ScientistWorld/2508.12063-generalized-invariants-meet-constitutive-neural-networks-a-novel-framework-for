# Apptainer definition file for GI-CANN hyperelastic materials reproduction.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything needed to run GI-CANN training and evaluation.
# The workspace is bind-mounted at /home/user at runtime.

Bootstrap: docker
From: ghcr.io/astral-sh/uv:python3.10-bookworm-slim

%post
    mkdir -p /home/user/data /home/user/checkpoints /home/user/scoring
    chmod 755 /home/user



    # --- Frozen environment (12 packages) ---
    # Sources: 0 both, 12 overlay-only, 0 setup-only
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    uv pip install --system \
        'filelock==3.25.2' \  # overlay
        'fsspec==2026.3.0' \  # overlay
        'jinja2==3.1.6' \  # overlay
        'markupsafe==3.0.3' \  # overlay
        'mpmath==1.3.0' \  # overlay
        'networkx==3.6.1' \  # overlay
        'numpy==2.4.3' \  # overlay
        'pillow==12.1.1' \  # overlay
        'setuptools==70.2.0' \  # overlay
        'sympy==1.13.1' \  # overlay
        'torch==2.5.1+cpu' \  # overlay
        'typing_extensions==4.15.0'  # overlay

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
