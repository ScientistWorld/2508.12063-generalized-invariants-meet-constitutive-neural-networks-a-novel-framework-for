# Apptainer definition file for GI-CANN hyperelastic materials reproduction.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything needed to run GI-CANN training and evaluation.
# The workspace is bind-mounted at /home/user at runtime.

Bootstrap: library
From: ubuntu:22.04

%post
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        vim nano less curl wget git tmux ca-certificates && \
    rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data /home/user/checkpoints /home/user/scoring
    chmod 755 /home/user

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
